generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model BatterySnapshot {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  userId       String
  level        Int
  range        Int
  isCharging   Boolean
  isConnected  Boolean
  chargingType String?
  odometer     Int?    

  @@index([userId, createdAt])
}

model ChargingSession {
  id           String    @id @default(cuid())
  userId        String 
  startedAt    DateTime
  endedAt      DateTime?
  startLevel   Int
  endLevel     Int?
  energyAdded  Float?
  chargingType String
  costPerKwh   Float?
  totalCost    Float?
  location     String?
  notes        String?
  isComplete   Boolean   @default(false)

    @@index([userId, startedAt])  
}

model Settings {
  id              String   @id
  userId          String   @unique
  homeTariff      Float    @default(0.25)
  publicTariff    Float    @default(0.50)
  batteryCapacity Float    @default(69.0)
  updatedAt       DateTime @updatedAt
}

model UserSession {
  id           String   @id @default(cuid())
  userId       String   @unique
  accessToken  String
  refreshToken String
  expiresAt    Int
  lastSeen     DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Trip {
  id                String   @id @default(cuid())
  userId            String
  startedAt         DateTime
  endedAt           DateTime?
  startOdometer     Int?
  endOdometer       Int?
  distanceKm        Float?
  startBattery      Int
  endBattery        Int?
  energyUsedKwh     Float?
  energyRegenKwh    Float?
  avgConsumption    Float?
  isComplete        Boolean  @default(false)

  @@index([userId, startedAt])
}