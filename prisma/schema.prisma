generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Connessione diretta (senza pooler) richiesta dalle migration.
  // Usiamo la variabile creata dall'integrazione Neon-Vercel invece di una
  // DIRECT_URL da aggiungere a mano: così è già presente ovunque.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model BatterySnapshot {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  userId       String
  level        Int
  range        Int
  isCharging   Boolean
  isConnected  Boolean
  chargingType String?
  // 'cron' oppure 'dashboard': serve a sapere chi ha scritto il campione
  source       String   @default("cron")
  odometer     Int?    

  @@index([userId, createdAt])
}

model ChargingSession {
  id           String    @id @default(cuid())
  userId        String 
  startedAt    DateTime
  endedAt      DateTime?
  startLevel   Int
  endLevel     Int?
  energyAdded  Float?
  chargingType String
  costPerKwh   Float?
  totalCost    Float?
  // I kWh letti dal contatore a muro: quelli PAGATI, contro energyAdded che
  // sono gli entrati nel pacco (dedotti da ΔSoC). L'efficienza è il rapporto,
  // e la prima coppia misurata (19.31 pagati vs 51->80%) ha già mostrato che
  // capacità 67 ed efficienza realistica non possono essere vere insieme.
  wallKwh      Float?
  location     String?
  notes        String?
  isComplete   Boolean   @default(false)

    @@index([userId, startedAt])  
}

model Settings {
  id              String   @id
  userId          String   @unique
  homeTariff      Float    @default(0.25)
  publicTariff    Float    @default(0.50)
  batteryCapacity Float    @default(67.0)
  updatedAt       DateTime @updatedAt
}

model UserSession {
  id           String   @id @default(cuid())
  userId       String   @unique
  accessToken  String
  refreshToken String
  expiresAt    Int
  lastSeen     DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ObdDevice {
  id        String    @id @default(cuid())
  userId    String
  name      String
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  lastSeen  DateTime?

  @@index([userId])
}

model ObdSample {
  id         String   @id @default(cuid())
  userId     String
  deviceId   String
  recordedAt DateTime
  createdAt  DateTime @default(now())

  // I campi rispecchiano i sensori realmente esposti dalla XC40 MY2023, letti
  // dalla lista di Car Scanner. Le temperature delle singole celle non ci sono:
  // il BECM espone solo il liquido di raffreddamento in ingresso e uscita.

  // Batteria di trazione (BECM)
  socDisplay     Float? // SOC del cruscotto, intero
  socReal        Float? // [BECM] HV Battery SoC, con i decimali
  soh            Float? // [BECM] HV Battery SoH
  packVoltage    Float? // [BECM] HV Battery voltage
  packCurrent    Float? // [BECM] HV Battery current
  packPowerKw    Float? // [BECM] Actual power, già in kW dalla centralina
  cellVoltageSum Float? // [BECM] HV Battery cell voltages summ
  coolantInletC  Float? // [BECM] HV Battery coolant inlet temperature
  coolantOutletC Float? // [BECM] HV Battery coolant outlet temperature

  // Veicolo
  odometer Float? // [DIM] Odometer
  speedKmh Float? // [IEM] Velocità veicolo

  // Clima: è la voce che spiega i consumi a veicolo fermo
  hvacPowerW Float? // [CCM] Current consumption HVCH-CCM, in Watt come la sorgente
  interiorC  Float? // [CCM] Interior temperature
  ambientC   Float? // temperatura esterna

  // Letture grezze dei DID Volvo, come mappa DID -> payload esadecimale.
  // Le formule di conversione vanno confermate osservando come i valori si
  // muovono nel tempo: finché non lo sono, il dato si conserva così com'è
  // invece di essere interpretato. Misurare e interpretare restano separati.
  didRaw Json?

  // Batteria 12V: serve a misurare quanto pesa il dongle stesso quando resta inserito
  batt12vSoc     Float? // [CEM] Battery SoC
  batt12vVoltage Float? // [CEM] Battery voltage
  parasiticMa    Float? // [CEM] Average static low range battery current

  // Un dongle che va in timeout rispedisce il batch: senza questo vincolo ogni
  // ritentativo duplicherebbe tutti i campioni. Due letture dello stesso
  // dispositivo nello stesso millisecondo non esistono, il polling OBD non
  // scende sotto il centinaio di millisecondi.
  @@unique([deviceId, recordedAt])
  @@index([userId, recordedAt])
}

// Arricchimento OBD dei viaggi: strato SEPARATO dal rilevatore, che non si
// tocca (docs/progetto-obd.md §4.2). Una riga per viaggio, ricalcolabile in
// ogni momento dai campioni grezzi: un derivato è solo l'ultima versione del
// grezzo, e i lotti arrivati tardi rifanno il conto senza chiedere permesso.
model TripEnrichment {
  id          String   @id @default(cuid())
  tripId      String   @unique
  userId      String
  updatedAt   DateTime @updatedAt
  sampleCount Int

  // Quota della durata realmente campionata (0-1). Decide il livello di
  // provenienza del titolo: i buchi non si interpolano, si dichiarano.
  coverage    Float
  // Intervalli non campionati dentro la finestra del viaggio, per le bande
  // grigie della UI: [{da, a}] in ISO, al massimo qualche decina.
  gaps        Json?

  // Rifinitura dei tempi: il cloud ricostruisce dai plateau dell'odometro,
  // i campioni con velocità > 0 sanno quando l'auto si muoveva davvero.
  movingStart DateTime?
  movingEnd   DateTime?

  // Misure di livello 1 disponibili già oggi
  distanceObdKm Float? // ∫ velocità sui soli tratti campionati
  maxSpeedKmh   Float?
  socStartObd   Float? // SOC display via OBD, passo osservato 0.784%, contro l'1% del cloud
  socEndObd     Float?

  // Pronti per quando la potenza avrà un DID confermato: ∫ potenza positiva e
  // ∫ potenza negativa in marcia (recupero lordo, non il saldo)
  energyGrossKwh      Float?
  energyRegenGrossKwh Float?

  // Niente indice su userId: ogni lettura passa da tripId (unique). Un indice
  // speculativo costerebbe un aggiornamento a ogni upsert senza servire nessuno.
}

model Trip {
  id                String   @id @default(cuid())
  userId            String
  startedAt         DateTime
  endedAt           DateTime?
  startOdometer     Int?
  endOdometer       Int?
  distanceKm        Float?
  startBattery      Int
  endBattery        Int?
  energyUsedKwh     Float?
  energyRegenKwh    Float?
  avgConsumption    Float?
  volvoAvgConsumption  Float?
  volvoTripMeterStart  Float?
  volvoTripMeterEnd    Float?
  energyFromVolvoKwh   Float?
  capacityEstimateKwh  Float?
  isComplete        Boolean  @default(false)

  @@index([userId, startedAt])
}