generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model BatterySnapshot {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  userId       String
  level        Int
  range        Int
  isCharging   Boolean
  isConnected  Boolean
  chargingType String?
  odometer     Int?    

  @@index([userId, createdAt])
}

model ChargingSession {
  id           String    @id @default(cuid())
  userId        String 
  startedAt    DateTime
  endedAt      DateTime?
  startLevel   Int
  endLevel     Int?
  energyAdded  Float?
  chargingType String
  costPerKwh   Float?
  totalCost    Float?
  location     String?
  notes        String?
  isComplete   Boolean   @default(false)

    @@index([userId, startedAt])  
}

model Settings {
  id              String   @id
  userId          String   @unique
  homeTariff      Float    @default(0.25)
  publicTariff    Float    @default(0.50)
  batteryCapacity Float    @default(67.0)
  updatedAt       DateTime @updatedAt
}

model UserSession {
  id           String   @id @default(cuid())
  userId       String   @unique
  accessToken  String
  refreshToken String
  expiresAt    Int
  lastSeen     DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ObdDevice {
  id        String    @id @default(cuid())
  userId    String
  name      String
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  lastSeen  DateTime?

  @@index([userId])
}

model ObdSample {
  id         String   @id @default(cuid())
  userId     String
  deviceId   String
  recordedAt DateTime
  createdAt  DateTime @default(now())

  socDisplay  Float?
  socReal     Float?
  soh         Float?
  packVoltage Float?
  packCurrent Float?
  cellTempMin Float?
  cellTempMax Float?
  hvacPowerKw Float?
  odometer    Float?
  speedKmh    Float?

  @@index([userId, recordedAt])
  @@index([deviceId, recordedAt])
}

model Trip {
  id                String   @id @default(cuid())
  userId            String
  startedAt         DateTime
  endedAt           DateTime?
  startOdometer     Int?
  endOdometer       Int?
  distanceKm        Float?
  startBattery      Int
  endBattery        Int?
  energyUsedKwh     Float?
  energyRegenKwh    Float?
  avgConsumption    Float?
  volvoAvgConsumption  Float?
  volvoTripMeterStart  Float?
  volvoTripMeterEnd    Float?
  energyFromVolvoKwh   Float?
  capacityEstimateKwh  Float?
  isComplete        Boolean  @default(false)

  @@index([userId, startedAt])
}